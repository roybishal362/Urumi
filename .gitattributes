# Keep Unix line endings on every platform. Shell scripts are mounted into Linux
# containers through a ConfigMap, where a Windows line ending breaks them.
* text=auto eol=lf
*.sh text eol=lf
*.php text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.tpl text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.ps1 text eol=crlf
*.png binary
